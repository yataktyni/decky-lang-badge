{
  "name": "decky-lang-badge",
  "version": "2.1.0",
  "description": "Displays localization badges for 29 Steam languages on Steam Deck (with Kuli.com.ua & LBK Launcher integration for Ukrainian).",
  "type": "module",
  "author": "Yataktyni",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/yataktyni/decky-lang-badge.git"
  },
  "bugs": {
    "url": "https://github.com/yataktyni/decky-lang-badge/issues"
  },
  "homepage": "https://github.com/yataktyni/decky-lang-badge#readme",
  "keywords": [
    "decky",
    "decky-plugin",
    "steam-deck",
    "steamdeck",
    "localization",
    "ukrainian",
    "badge"
  ],
  "scripts": {
    "build": "shx rm -rf dist && rollup -c",
    "build:admin": "ADMIN_BUILD=1 shx rm -rf dist && ADMIN_BUILD=1 rollup -c",
    "watch": "rollup -c -w",
    "release": "bash ./scripts/release.sh",
    "zip": "zip -r release.zip . -x 'node_modules/*' '.git/*' '.agent/*' '.agents/*' '.kilocode/*' '.venv/*' 'venv/*' '__pycache__/*' 'src/*' 'tests/*' 'scripts/*' '*.code-workspace' 'tsconfig.json' 'rollup.config.js' 'vitest.config.ts' 'pytest.ini' 'requirements-dev.txt' 'decky.pyi' 'pnpm-lock.yaml'",
    "test:frontend": "vitest run --environment jsdom",
    "test": "pnpm test:frontend"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^5.0.2",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/webpack": "^5.28.5",
    "jsdom": "^25.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rollup": "^4.22.5",
    "shx": "^0.3.4",
    "typescript": "^5.6.2",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
